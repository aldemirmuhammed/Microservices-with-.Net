@using FreeCourse.Web.Views.Account;
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h4>@ViewData["Title"]</h4>
@if (TempData["DeletePersonalDataStatus"] != null)
{
    <partial name="~/Views/Account/_StatusMessage.cshtml" for="@TempData["DeletePersonalDataStatus"]" />
}
@if (TempData["DownloadPersonalDataStatus"] != null)
{
    <partial name="~/Views/Account/_StatusMessage.cshtml" for="@TempData["DownloadPersonalDataStatus"]" />
}


<div class="row">
    <div class="col-md-4 offset-md-4">
        <div class="card">
            <div class="card-body">
                <p>Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
                <p>
                    <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
                </p>
                <form id="download-data" asp-controller="PersonalData" asp-action="Download" method="post" class="form-group mb-3">
                    <button class="btn btn-primary btn-block mb-3" type="submit">Download</button>
                </form>

                <p> <a class="btn btn-primary btn-block mb-3" asp-controller="PersonalData" asp-action="Delete">Delete</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
