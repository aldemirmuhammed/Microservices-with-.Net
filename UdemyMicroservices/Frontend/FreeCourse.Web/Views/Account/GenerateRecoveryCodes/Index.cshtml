@using FreeCourse.Web.Models.Account.GenerateRecoveryCodes
@using FreeCourse.Web.Views.Account
@model GenerateRecoveryCodesViewModel
@{
    ViewData["Title"] = "Generate two-factor authentication (2FA) recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

@if (TempData["GenerateRecoveryCodesStatus"] != null)
{
    var aa = TempData["GenerateRecoveryCodesStatus"];
    <partial name="~/Views/Account/_StatusMessage.cshtml" for="@aa" />
}

<h4>@ViewData["Title"]</h4>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Put these codes in a safe place.</strong>
    </p>
    <p>
        If you lose your device and don't have the recovery codes you will lose access to your account.
    </p>
    <p>
        Generating new recovery codes does not change the keys used in authenticator apps. If you wish to change the key
        used in an authenticator app you should <a asp-action="Index" asp-controller="ResetAuthenticator">reset your authenticator keys.</a>
    </p>
</div>
<div>
    <form method="post" asp-action="GenerateRecoveryCodes" asp-controller="GenerateRecoveryCodes" class="form-group">
        <button class="btn btn-danger" type="submit">Generate Recovery Codes</button>
    </form>
</div>