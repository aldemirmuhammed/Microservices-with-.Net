@using FreeCourse.Web.Models.Account.RegisterConfirmation
@model RegisterConfirmationViewModel
@{
    ViewData["Title"] = "Register confirmation";
}

<h1>@ViewData["Title"]</h1>
@{
    if (TempData["DisplayConfirmAccountLink"] != null && (bool)TempData["DisplayConfirmAccountLink"] && TempData["EmailConfirmationUrl"] != null)
    {
        <p>
            This app does not currently have a real email sender registered, see <a href="https://aka.ms/aspaccountconf">these docs</a> for how to configure a real email sender.
            Normally this would be emailed: <a id="confirm-link" href="@TempData["EmailConfirmationUrl"]">Click here to confirm your account</a>
        </p>
    }
    else
    {
        <p>
            Please check your email to confirm your account.
        </p>
    }
}
