@model List<CourseViewModel>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.0.3/css/font-awesome.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js" rel="stylesheet" />
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.bundle.min.js" rel="stylesheet" />
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" rel="stylesheet" />
<link href="~/css/course_list.css" rel="stylesheet" />


@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {

        <div class="container py-5">

            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <ul class="list-group shadow">
                        <li class="list-group-item">
                            <div class="media align-items-lg-center flex-column flex-lg-row p-3">
                                <div class="media-body order-2 order-lg-1">
                                    <h5 class="mt-0 font-weight-bold mb-2">@item.Name</h5>
                                    <p class="font-italic text-muted mb-0 small">@item.Description</p>
                                    <div class="d-flex align-items-center justify-content-between mt-1">
                                        <h6 class="font-weight-bold my-2">€ @item.Price</h6>
                                        @if (item.CourseRate > 0)
                                        {
                                            @for (int i = 0; i < Convert.ToInt16(@item.CourseRate); i++)
                                            {
                                                <span><i class="fa-solid fa-star" style="color: #FFD43B;"></i></span>
                                            }
                                            @for (int i = Convert.ToInt16(@item.CourseRate); i < 5; i++)
                                            {
                                                <span><i class="fa-regular fa-star"></i></span>
                                            }
                                        }
                                        else
                                        {
                                            @for (int i = 0; i < 5; i++)
                                            {
                                                <span disabled="disabled"><i class="fa-regular fa-star"></i></span>
                                            }
                                        }
                                        @* 
                                        <ul class="list-inline small">
                                            <li class="list-inline-item m-0"><i class="fa fa-star text-success"></i></li>
                                            <li class="list-inline-item m-0"><i class="fa fa-star text-success"></i></li>
                                            <li class="list-inline-item m-0"><i class="fa fa-star text-success"></i></li>
                                            <li class="list-inline-item m-0"><i class="fa fa-star text-success"></i></li>
                                            <li class="list-inline-item m-0"><i class="fa fa-star-o text-gray"></i></li>
                                        </ul> *@
                                    </div>
                                </div><img src="@item.StockPictureUrl" alt="Generic placeholder image" width="200" class="ml-lg-5 order-1 order-lg-2">
                            </div>
                        </li>

                    </ul>
                </div>
            </div>
        </div>
    }
}
