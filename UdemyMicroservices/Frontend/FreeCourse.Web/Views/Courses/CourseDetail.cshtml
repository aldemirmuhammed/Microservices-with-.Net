@using FreeCourse.Web.Models.Catalogs.Course.CourseComment
@using FreeCourse.Web.Services.Interfaces


@model CourseViewModel
@inject ICatalogService _catalogService
<head>
    <link href="~/css/comment_post.css" rel="stylesheet" />
    <link href="~/css/comment_tabs.css" rel="stylesheet" />
    <link href="//maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">

</head>
@if (Model != null)
{
    <div class="card w-100">
        <div class="card-body">
            <img src="@Model.StockPictureUrl" class="card-img-top" />

            <h5 class="card-title" style="margin-top:10px">@Model.Name</h5>
            <div class="d-flex justify-content-between">
                <div class="d-flex flex-row align-items-center">
                    <div class="badge bg-primary"> @Model.Category.Name</div>
                </div>
                <div class="d-flex justify-content-between">
                    <div class="d-flex flex-row align-items-center">
                        @if (Model.CourseRate > 0)
                        {
                            @for (int i = 0; i < Convert.ToInt16(@Model.CourseRate); i++)
                            {
                                <span><i class="fa-solid fa-star" style="color: #FFD43B;"></i></span>
                            }
                            @for (int i = Convert.ToInt16(@Model.CourseRate); i < 5; i++)
                            {
                                <span><i class="fa-regular fa-star"></i></span>
                            }
                        }
                        else
                        {
                            @for (int i = 0; i < 5; i++)
                            {
                                <span disabled="disabled"><i class="fa-regular fa-star"></i></span>
                            }
                        }
                    </div>

                    <div class="d-flex flex-row align-items-center">

                        @{
                            var _countStar = (Model.CourseCommentList != null && Model.CourseCommentList.Count != 0) ? Model.CourseCommentList.Count : 0;
                        }

                        <p class="card-text">(@_countStar)</p>
                    </div>
                </div>

            </div>
            <div class="d-flex justify-content-between">
                <div class="d-flex flex-row align-items-center">
                    <p class="card-text"> @Model.Description</p>
                </div>
                <div>
                    @if (User.Identity.IsAuthenticated && Model.IsFavorite)
                    {
                        <a asp-controller="Courses" asp-action="DeleteFavoriteCourse" asp-route-courseId="@Model.Id">
                            <i class="fa-solid fa-heart"></i>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Courses" asp-action="CreateFavoriteCourse" asp-route-courseId="@Model.Id">
                            <i class="fa-regular fa-heart"></i>
                        </a>
                    }
                </div>
            </div>
        </div>

    </div>
}

