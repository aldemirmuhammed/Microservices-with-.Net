@using FreeCourse.Web.Models.Catalogs.Course.CourseComment
@using FreeCourse.Web.Services.Interfaces
@model CourseCommentViewModel;

 <head>
     <link href="~/css/comment_main.css" rel="stylesheet" />
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.3.0/css/font-awesome.min.css" rel="stylesheet"> 

</head> 
@if (Model != null && Model.CourseId != null)
{
      <form asp-controller="Courses" asp-action="CommentCreate" method="post" enctype="multipart/form-data">

        <div class="card">
            <div class="row">
                <div class="col-2">
                    <img class="rounded-circle shadow-1-strong me-3"
                         src="data:image/*;base64,@(Convert.ToBase64String(Model.User.ProfilePicture))" alt="avatar" width="65" height="65" />

                </div>
                <div class="col-10">
                    <div class="comment-box ml-2">
                        <h4>Add a comment</h4>

                        <div class="form-group">
                           
                            <div class="col-6">
                                <jQuery-Rating max-size="5"
                                               rating="@Model.CourseRate"
                                               onchange-event="onGetRatingValue">
                                </jQuery-Rating>
                            </div>
                        </div>
                        <div class="comment-area">
                            <input asp-for="@Model.CourseId" class="form-control" style="display:none" rows="4"/>
                            <textarea asp-for="@Model.CommentDescription" class="form-control" placeholder="* what is your view?" rows="4"></textarea>
                        </div>
                        <div class="comment-btns mt-2">
                            <button class="btn btn-success send btn-sm">
                                Send <i class="fa fa-long-arrow-right ml-1"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>  



}


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script type="text/javascript">
        function onGetRatingValue(rateValue) {
            console.log("Rate Value :", rateValue);

            $("#rateDisplay").html(rateValue);
        }
    </script>
}