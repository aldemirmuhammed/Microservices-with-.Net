@using FreeCourse.Web;
@using FreeCourse.Web.Models.Notifications;
@model List<CourseViewModel>
@{
    ViewData["Title"] = "Favorite Courses";
    var count = 0;
}
<h2>Favorite Courses</h2>
<hr />

@if (Model != null)
{
    @if (Model.Any())
    {
        @foreach (var item in Model)
        {
            count++;
            if (count == 1 || (count % 3 == 1))
            {
                @Html.Raw("<div class='row row-cols-1 row-cols-md-3 g-4 mb-2' >")
            }
            <div class="col">
                <div class="card">
                    <img src="@item.StockPictureUrl" class="card-img-top" alt="...">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <div class="badge bg-primary">Kategori : @item.Category.Name</div>
                        <p class="card-text">@item.ShortDescription</p>
                        <div class="d-flex justify-content-between">

                            <div class="d-flex flex-row align-items-center">
                                <h4 class="text-primary">@item.Price TL</h4>
                            </div>
                            <div>
                                <a asp-controller="Courses" asp-action="DeleteFavoriteCourse" asp-route-courseId="@item.Id">
                                    <i class="fa-solid fa-heart"></i>
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            if (count % 3 == 0)
            {
                @Html.Raw("</div>")
            }

        }
    }
    else
    {
        <div class="alert alert-info">Not found favorite courses</div>
    }
}
else
{
    <div class="alert alert-info">Not found favorite courses</div>
}
